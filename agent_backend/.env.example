# Copy to .env and fill in. .env is git-ignored; never commit real keys.
#   set -a && source agent_backend/.env && set +a
#   .venv/bin/uvicorn agent_backend.main:app --reload --port 8000

# --- Model access (required) -------------------------------------------------
# The agent loop calls Claude directly via the Anthropic SDK.
ANTHROPIC_API_KEY=sk-ant-...

# Claude Opus 5 is the most capable model and the default here — this pipeline
# is long-horizon agentic work, which is where it earns its cost.
# Cheaper tiers if you need them: claude-sonnet-5, claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-5

# Caps thinking AND response text together. Adaptive thinking is on by default
# on Opus 5, so don't size this for the answer alone.
AGENT_MAX_TOKENS=16000

# low | medium | high | xhigh | max. `high` is the API default.
# `xhigh` gives deeper planning and more tool use per turn — raise
# AGENT_MAX_TOKENS to ~64000 alongside it or turns truncate.
AGENT_EFFORT=high

AGENT_MAX_STEPS=8            # per-agent loop budget
# Fast-lane consolidated Researcher:core only — it covers ~10 components in one
# agent, so it needs a larger budget than the per-agent default.
AGENT_RESEARCH_STEPS=12

# --- LLM bridge (OpenAI-compatible) -------------------------------------------
# LLM_PROVIDER picks the path: `openai` routes every agent through the Fireworks
# bridge, `anthropic` calls Claude directly. `openai` is the default in base.py,
# so set it to anthropic explicitly to go direct — unsetting it is not enough.
LLM_PROVIDER=openai
LLM_BASE_URL=https://hackathon.josephbissell.com/v1
LLM_MODEL=kimi-latest
LLM_API_KEY=<bridge key — required; the bridge 401s without it>

# --- Bright Data Web Unlocker (optional; scraping + web_search) --------------
# brightdata_scrape POSTs https://api.brightdata.com/request — fetches any URL
# past bot detection/CAPTCHAs and returns markdown. It validates caller-given
# `expect` markers and self-repairs (re-fetch with render=true) when a site's
# HTML changes. web_search rides the same credentials to unlock Google results
# pages. Without a token both degrade gracefully and agents fall back to
# kb_lookup. See CLAUDE.md "Bright Data Scraper Settings".
BRIGHTDATA_API_TOKEN=          # API key from https://brightdata.com/cp/setting/users
BRIGHTDATA_ZONE=web_unlocker1  # Web Unlocker zone, managed at https://brightdata.com/cp/zones
BRIGHTDATA_TIMEOUT_S=60        # per-request timeout; JS-rendered repair fetches are slow
DOC_DIR=                     # defaults to ./project-docs
KB_DIR=                      # defaults to ./research

# --- Port control plane (optional; docs/port-factory.md) ----------------------
# Software-factory telemetry: each job becomes a factory_run entity in Port,
# each agent a related factory_agent_run, findings become factory_finding
# entities, and every finished run lands in AWAITING_REVIEW for a human to
# approve in the Port UI. Unset = zero Port calls; the pipeline never blocks on it.
# Credentials: Port app → "..." (top right) → Credentials.
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=
PORT_API_BASE=https://api.port.io        # EU; US orgs use https://api.us.port.io
APP_PUBLIC_URL=http://localhost:8000     # used to build the reportUrl on the run entity

# --- Tracing -----------------------------------------------------------------
TRACE_LEVEL=info             # debug | info | warn — debug shows every LLM/tool start
TRACE_COLOR=auto             # auto | always | never
TRACE_PAYLOADS=0             # 1 logs full prompts/args/results (verbose, may include doc text)

# --- SigNoz observability (optional) ------------------------------------------
# Every trace obs.py already emits (phases, LLM/tool calls, scraper ops) also
# exports to SigNoz as OpenTelemetry spans when either of these is set.
# SigNoz Cloud: Settings → Workspace → Ingestion Keys. Region: us | eu | in.
SIGNOZ_INGESTION_KEY=
SIGNOZ_REGION=us
# Self-hosted SigNoz instead: point at its collector, no key needed.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=rai-backend
# OTEL_SERVICE_VERSION=        # defaults to the git short SHA → deployment markers
# TELEMETRY_CONSOLE=0          # 1 prints spans to stdout instead of exporting (debug)
